{
  "modelArchitecture": "DecoderOnlyTransformer",
  "vocabSize": 32000,
  "contextWindowLength": 4096,
  "dModel": 768,
  "numLayers": 12,
  "numAttentionHeads": 12,
  "headDimension": 64,
  "feedForwardDimension": 3072,
  "dropoutRate": 0.1,
  "activationFunction": "GeLU",
